rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is a member of a family
    function isFamilyMember(familyId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null ||
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members
      );
    }

    // Users: any authenticated user can read profiles (needed for family member lists)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Families: members can read, any authenticated user can create
    match /families/{familyId} {
      allow read: if request.auth != null && (
        resource.data.members[request.auth.uid] != null ||
        request.auth.uid in resource.data.members
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.members[request.auth.uid] != null ||
        request.auth.uid in resource.data.members
      );
      allow delete: if false;

      match /config/{configId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null ||
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members
        );
      }
    }

    // Events: family-scoped
    match /events/{eventId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Chat: family-scoped
    match /chat/{messageId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Shopping lists: family-scoped
    match /shoppingLists/{listId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Trips + subcollections: family-scoped
    match /trips/{tripId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
      match /{subcollection=**} {
        allow read, write: if request.auth != null && isFamilyMember(/databases/$(database)/documents/trips/$(tripId)).data.familyId;
      }
    }

    // Birthdays: family-scoped
    match /birthdays/{birthdayId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Gift Ideas: family-scoped
    match /gifts/{giftId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pets: family-scoped
    match /pets/{petId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Vet Visits: family-scoped
    match /petVetVisits/{visitId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Medications: family-scoped
    match /petMedications/{medId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Food: family-scoped
    match /petFood/{foodId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Grooming: family-scoped
    match /petGrooming/{groomId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Vaccinations: family-scoped
    match /petVaccinations/{vaccId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Pet Insurance: family-scoped
    match /petInsurance/{insId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Spond Responses: family-scoped
    match /spondResponses/{responseId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Health: family-scoped (top-level doc has familyId as document ID)
    match /health/{familyId} {
      allow read, write: if request.auth != null && isFamilyMember(familyId);
      match /{subcollection=**} {
        allow read, write: if request.auth != null && isFamilyMember(familyId);
      }
    }

    // School Children: family-scoped
    match /schoolChildren/{childId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // School Years: family-scoped
    match /schoolYears/{yearId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // School Contacts: family-scoped
    match /schoolContacts/{contactId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // School Schedules: family-scoped
    match /schoolSchedules/{scheduleId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Recipes: family-scoped
    match /recipes/{recipeId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Meal Plans: family-scoped
    match /mealPlans/{planId} {
      allow read, update, delete: if request.auth != null && isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null && isFamilyMember(request.resource.data.familyId);
    }

    // Sent notifications: Cloud Function writes, users read own notifications
    match /sentNotifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
