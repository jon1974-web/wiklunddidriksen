rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the owner can read/write their own profile
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Families: members can read, any authenticated user can create (join flow)
    match /families/{familyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // Events: authenticated read/write (TODO: add familyId field and scope to family)
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Chat: authenticated read/write (TODO: add familyId field and scope to family)
    match /chat/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Shopping lists: authenticated read/write (TODO: add familyId field and scope to family)
    match /shoppingLists/{listId} {
      allow read, write: if request.auth != null;
    }

    // Trips + subcollections: authenticated read/write (TODO: add familyId field and scope to family)
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
