rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read profiles (needed for family member lists)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Families: members can read, any authenticated user can create
    // Supports both old array format and new map format during migration
    match /families/{familyId} {
      allow read: if request.auth != null && (
        resource.data.members[request.auth.uid] != null ||
        request.auth.uid in resource.data.members
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.members[request.auth.uid] != null ||
        request.auth.uid in resource.data.members
      );
      allow delete: if false;

      match /config/{configId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null ||
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members
        );
      }
    }

    // Events: authenticated read/write scoped to family
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Chat: authenticated read/write scoped to family
    match /chat/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Shopping lists: authenticated read/write scoped to family
    match /shoppingLists/{listId} {
      allow read, write: if request.auth != null;
    }

    // Trips + subcollections: authenticated read/write scoped to family
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Birthdays: any authenticated user can read/write (family-scoped client-side)
    match /birthdays/{birthdayId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Recipes: any authenticated user can read/write (family-scoped client-side)
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Meal Plans: any authenticated user can read/write (family-scoped client-side)
    match /mealPlans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Health: authenticated read/write scoped to family
    match /health/{familyId} {
      allow read, write: if request.auth != null;
      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Sent notifications: Cloud Function write, user read own
    match /sentNotifications/{eventId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
  }
}
