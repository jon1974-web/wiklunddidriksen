[debug] [2026-08-08T15:29:08.226Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/familiesenter-837bb/rulesets {"name":"projects/familiesenter-837bb/rulesets/b002ac2d-fefb-45ae-852f-a4851ee3d600","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if user is a member of a family\n    function isFamilyMember(familyId) {\n      return request.auth != null && (\n        get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null ||\n        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members\n      );\n    }\n\n    // Helper to get familyId from resource (reads/updates) or request (creates)\n    function getFamilyId() {\n      return resource != null ? resource.data.familyId : request.resource.data.familyId;\n    }\n\n    // Users: any authenticated user can read profiles (needed for family member lists)\n    match /users/{uid} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null && request.auth.uid == uid;\n      allow update: if request.auth != null && request.auth.uid == uid;\n      allow delete: if false;\n    }\n\n    // Families: members can read, any authenticated user can create\n    match /families/{familyId} {\n      allow read: if request.auth != null && (\n        resource.data.members[request.auth.uid] != null ||\n        request.auth.uid in resource.data.members\n      );\n      allow create: if request.auth != null;\n      allow update: if request.auth != null && (\n        resource.data.members[request.auth.uid] != null ||\n        request.auth.uid in resource.data.members\n      );\n      allow delete: if false;\n\n      match /config/{configId} {\n        allow read, write: if request.auth != null && (\n          get(/databases/$(database)/documents/families/$(familyId)).data.members[request.auth.uid] != null ||\n          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members\n        );\n      }\n    }\n\n    // Events: family-scoped\n    match /events/{eventId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Chat: family-scoped\n    match /chat/{messageId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Shopping lists: family-scoped\n    match /shoppingLists/{listId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Trips + subcollections: family-scoped\n    match /trips/{tripId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n      match /{subcollection=**} {\n        allow read, write: if request.auth != null;\n      }\n    }\n\n    // Birthdays: family-scoped\n    match /birthdays/{birthdayId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Gift Ideas: family-scoped\n    match /gifts/{giftId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pets: family-scoped\n    match /pets/{petId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Vet Visits: family-scoped\n    match /petVetVisits/{visitId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Medications: family-scoped\n    match /petMedications/{medId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Food: family-scoped\n    match /petFood/{foodId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Grooming: family-scoped\n    match /petGrooming/{groomId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Vaccinations: family-scoped\n    match /petVaccinations/{vaccId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Pet Insurance: family-scoped\n    match /petInsurance/{insId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Spond Responses: family-scoped\n    match /spondResponses/{responseId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Health: family-scoped\n    match /health/{familyId} {\n      allow read, write: if request.auth != null && isFamilyMember(familyId);\n      match /{subcollection=**} {\n        allow read, write: if request.auth != null;\n      }\n    }\n\n    // Recipes: family-scoped\n    match /recipes/{recipeId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Meal Plans: family-scoped\n    match /mealPlans/{planId} {\n      allow read, write: if request.auth != null && isFamilyMember(getFamilyId());\n    }\n\n    // Sent notifications: Cloud Function write, user read own\n    match /sentNotifications/{eventId} {\n      allow read: if request.auth != null;\n      allow write: if true;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-08T15:29:08.227119Z","metadata":{"services":["cloud.firestore"]}}
