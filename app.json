{
  "expo": {
    "name": "Familiesenter",
    "slug": "Familiesenter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Familiesenter",
      "infoPlist": {
        "NSCameraUsageDescription": "Familiesenter bruker kameraet til å ta bilder som kan deles i chatten.",
        "NSPhotoLibraryUsageDescription": "Familiesenter bruker bildebiblioteket til å velge bilder som kan deles i chatten."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Familiesenter",
      "shortName": "Familiesenter",
      "description": "Familie arrangement administrasjon",
      "lang": "no",
      "startUrl": "/",
      "display": "standalone",
      "backgroundColor": "#f5f5f5",
      "themeColor": "#0097A7",
      "manifest": "./public/manifest.json",
      "headTags": {
        "meta": [
          { "name": "apple-mobile-web-app-capable", "content": "yes" },
          { "name": "apple-mobile-web-app-status-bar-style", "content": "default" },
          { "name": "apple-mobile-web-app-title", "content": "Familiesenter" }
        ],
        "link": [
          { "rel": "manifest", "href": "/manifest.json" }
        ]
      }
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Familiesenter trenger tilgang til kalenderen din for a legge til arrangementer."
        }
      ],
      "expo-localization"
    ]
  }
}
